{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "$comment": "agent-kit's own project rules (issue: Harness agent-kit itself before agents work on it). The deny list is the account floor's (account/settings.json, ADR 0017): the template's list plus the --force variants the probe found missing. agent-kit has only main; the dev and staging rules are kept so the list stays the kit's and the probe cases stay generic. Run scripts/probe/ after every change to this file. skillOverrides and the mcp__Claude_Docs deny cut the tools nobody asked for (issue: Count active tools, skills and MCP servers): see docs/tools.md before adding or re-enabling one.",
  "permissions": {
    "ask": [
      "Edit(./.github/workflows/**)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git push * --force*)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push)",
      "Bash(git push origin)",
      "Bash(git push * HEAD)",
      "Bash(git push * HEAD *)",
      "Bash(git push * dev)",
      "Bash(git push * dev *)",
      "Bash(git push *:dev)",
      "Bash(git push *:dev *)",
      "Bash(git push */dev)",
      "Bash(git push */dev *)",
      "Bash(git push *+dev)",
      "Bash(git push *+dev *)",
      "Bash(git push * staging)",
      "Bash(git push * staging *)",
      "Bash(git push *:staging)",
      "Bash(git push *:staging *)",
      "Bash(git push */staging)",
      "Bash(git push */staging *)",
      "Bash(git push *+staging)",
      "Bash(git push *+staging *)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push *:main)",
      "Bash(git push *:main *)",
      "Bash(git push */main)",
      "Bash(git push */main *)",
      "Bash(git push *+main)",
      "Bash(git push *+main *)",
      "Bash(rm -rf *)",
      "mcp__Claude_Docs"
    ]
  },
  "skillOverrides": {
    "anthropic-skills:artifact-emulator": "off",
    "anthropic-skills:built-in-browser": "off",
    "anthropic-skills:chrome-browser": "off",
    "anthropic-skills:computer-use": "off",
    "anthropic-skills:deep-research": "off",
    "anthropic-skills:docs": "off",
    "anthropic-skills:docx": "off",
    "anthropic-skills:google-workspace": "off",
    "anthropic-skills:import-memory": "off",
    "anthropic-skills:morning": "off",
    "anthropic-skills:pptx": "off",
    "anthropic-skills:xlsx": "off",
    "artifact-capabilities": "name-only",
    "artifact-diagramming": "name-only",
    "dataviz": "name-only",
    "design": "off",
    "design-sync": "off",
    "slides": "off"
  }
}
