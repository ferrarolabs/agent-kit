{
  "$comment": "Cases for scripts/probe/probe-deny-rules.js. Generic: the kit's default long-lived branches are dev, staging and main. 'deny' cases must be denied by a deny rule; 'allow' cases are controls that catch rules that over-block. Proven first on jamly (jamly PR 5: 12 of 12 denied, 4 of 4 allowed).",
  "cases": [
    { "command": "git push origin dev", "expect": "deny" },
    { "command": "git push origin HEAD:dev", "expect": "deny" },
    { "command": "git push origin +dev", "expect": "deny" },
    { "command": "git push --dry-run origin dev", "expect": "deny" },
    { "command": "git push -u origin dev", "expect": "deny" },
    { "command": "git push origin refs/heads/dev", "expect": "deny" },
    { "command": "git push origin probe-deny-rules:staging", "expect": "deny" },
    { "command": "git push origin main --dry-run", "expect": "deny" },
    { "command": "git push --force-with-lease origin probe-deny-rules", "expect": "deny" },
    { "command": "git push", "expect": "deny" },
    { "command": "git push origin", "expect": "deny" },
    { "command": "git push origin HEAD", "expect": "deny" },
    { "command": "git push -u origin feat/0-domain", "expect": "allow" },
    { "command": "git push -u origin feat/0-dev-tools", "expect": "allow" },
    { "command": "git push --dry-run origin fix/1-maintenance", "expect": "allow" },
    { "command": "git push -u origin docs/2-staging-notes", "expect": "allow" }
  ]
}
